<UserControl x:Class="GB_Payroll_System.Views.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filters: Date Range -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="From:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="DpFrom" Height="36" FontSize="13" Width="140" SelectedDateChanged="Filter_Changed"/>
                    <TextBlock Text="To:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <DatePicker x:Name="DpTo" Height="36" FontSize="13" Width="140" SelectedDateChanged="Filter_Changed"/>
                    <TextBlock Text="Status:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <ComboBox x:Name="CboStatus" Width="140" Height="36" FontSize="13" SelectionChanged="Filter_Changed">
                        <ComboBoxItem Content="All Status" IsSelected="True"/>
                        <ComboBoxItem Content="Present"/>
                        <ComboBoxItem Content="Absent"/>
                        <ComboBoxItem Content="On Leave"/>
                        <ComboBoxItem Content="Half Day"/>
                        <ComboBoxItem Content="Holiday"/>
                    </ComboBox>
                    <Border Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="4"
                            Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtRecordCount" Text="0 records" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnImport" Content="📥  Import Biometric File"
                            Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#BEE3F8" BorderThickness="1"
                            Height="38" Padding="14,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                            Click="BtnImport_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAddManual" Content="➕  Manual Entry"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Height="38" Padding="14,0" Click="BtnAddManual_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ATTENDANCE DATA GRID -->
        <DataGrid Grid.Row="1" x:Name="AttendanceGrid"
                  Margin="20,16,20,0" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9FAFB"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                  HeadersVisibility="Column" CanUserResizeRows="False"
                  ColumnHeaderHeight="40" RowHeight="44"
                  MouseDoubleClick="AttendanceGrid_MouseDoubleClick">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#718096"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#1A202C"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="Foreground" Value="#1A202C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F7FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='MMM dd, yyyy (ddd)'}" Width="180"/>
                <DataGridTextColumn Header="EMPLOYEE CODE" Binding="{Binding EmployeeCode}" Width="130"/>
                <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="170"/>
                <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="130"/>
                <DataGridTextColumn Header="TIME IN" Binding="{Binding TimeInDisplay}" Width="100"/>
                <DataGridTextColumn Header="TIME OUT" Binding="{Binding TimeOutDisplay}" Width="100"/>
                <DataGridTextColumn Header="LATE" Binding="{Binding LateDisplay}" Width="80"/>
                <DataGridTextColumn Header="OT HOURS" Binding="{Binding OTDisplay}" Width="90"/>
                <DataGridTextColumn Header="REG HRS" Binding="{Binding RegularHoursWorked, StringFormat={}{0:F2}}" Width="80"/>

                <!-- STATUS badge column -->
                <DataGridTemplateColumn Header="STATUS" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#C6F6D5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                <Setter Property="Background" Value="#FED7D7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OnLeave">
                                                <Setter Property="Background" Value="#FEFCBF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="HalfDay">
                                                <Setter Property="Background" Value="#BEE3F8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Holiday">
                                                <Setter Property="Background" Value="#E9D8FD"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#276749"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Absent">
                                                    <Setter Property="Foreground" Value="#9B2C2C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="OnLeave">
                                                    <Setter Property="Foreground" Value="#744210"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="HalfDay">
                                                    <Setter Property="Foreground" Value="#1A365D"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Holiday">
                                                    <Setter Property="Foreground" Value="#44337A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Adjusted indicator -->
                <DataGridTemplateColumn Header="ADJUSTED" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value=""/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManuallyAdjusted}" Value="True">
                                                <Setter Property="Text" Value="✏️"/>
                                                <Setter Property="ToolTip" Value="{Binding AdjustmentReason}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Actions -->
                <DataGridTemplateColumn Header="ACTIONS" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Button Content="✏️ Correct" Tag="{Binding Id}" Click="BtnCorrect_Click"
                                        Background="#FEFCBF" Foreground="#744210" BorderThickness="0"
                                        Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- SUMMARY BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#C6F6D5" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtPresentCount" Text="Present: 0" FontSize="12" FontWeight="Bold" Foreground="#276749"/>
                    </Border>
                    <Border Background="#FED7D7" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtAbsentCount" Text="Absent: 0" FontSize="12" FontWeight="Bold" Foreground="#9B2C2C"/>
                    </Border>
                    <Border Background="#FEFCBF" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtLeaveCount" Text="On Leave: 0" FontSize="12" FontWeight="Bold" Foreground="#744210"/>
                    </Border>
                    <Border Background="#BEE3F8" CornerRadius="4" Padding="10,4">
                        <TextBlock x:Name="TxtLateCount" Text="Late: 0" FontSize="12" FontWeight="Bold" Foreground="#1A365D"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtTotalOT" Text="Total OT: 0.00 hrs"
                           FontSize="12" FontWeight="Bold" Foreground="#2B6CB0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
