<Window x:Class="GB_Payroll_System.Views.BiometricImportWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Biometric File Import Wizard" Height="640" Width="760"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MinHeight="560" MinWidth="680"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="📥  Biometric File Import Wizard" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Import Time In / Time Out logs from a biometric device CSV or text file" FontSize="12" Foreground="#93C5FD"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <Grid Grid.Row="1" Margin="24,20,24,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Step 1: File Selection -->
            <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="STEP 1 — SELECT BIOMETRIC LOG FILE" FontSize="11"
                               FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="6" Height="44" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtFilePath" Text="No file selected..." FontSize="13"
                                       Foreground="#A0AEC0" VerticalAlignment="Center" Margin="12,0"/>
                        </Border>
                        <Button Grid.Column="1" Content="Browse File" Background="#EBF8FF" Foreground="#2B6CB0"
                                BorderBrush="#BEE3F8" BorderThickness="1" Height="44" FontWeight="Bold"
                                Cursor="Hand" Click="BtnBrowse_Click"/>
                    </Grid>

                    <!-- Format info -->
                    <Border Background="#FFFAF0" BorderBrush="#FEEBC8" BorderThickness="1" CornerRadius="6"
                            Padding="12,8" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="📋  Accepted CSV Format (one row per punch):" FontSize="11" FontWeight="Bold" Foreground="#744210"/>
                            <TextBlock Text="EmployeeID , Date , Time , PunchType (1=IN / 0=OUT)" FontSize="12"
                                       Foreground="#744210" Margin="0,4,0,0" FontFamily="Consolas"/>
                            <TextBlock Text="Example:   001 , 2026-07-25 , 08:03 , 1" FontSize="12"
                                       Foreground="#92400E" Margin="0,2,0,0" FontFamily="Consolas"/>
                            <TextBlock Text="Example:   001 , 2026-07-25 , 17:32 , 0" FontSize="12"
                                       Foreground="#92400E" Margin="0,2,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Step 2: Preview Options -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20"
                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SHIFT START" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboShiftStart" Height="40" FontSize="13">
                            <ComboBoxItem Content="08:00 AM" Tag="08:00" IsSelected="True"/>
                            <ComboBoxItem Content="07:00 AM" Tag="07:00"/>
                            <ComboBoxItem Content="09:00 AM" Tag="09:00"/>
                            <ComboBoxItem Content="10:00 PM" Tag="22:00"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SHIFT END" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboShiftEnd" Height="40" FontSize="13">
                            <ComboBoxItem Content="05:00 PM" Tag="17:00" IsSelected="True"/>
                            <ComboBoxItem Content="04:00 PM" Tag="16:00"/>
                            <ComboBoxItem Content="06:00 PM" Tag="18:00"/>
                            <ComboBoxItem Content="06:00 AM" Tag="06:00"/>
                        </ComboBox>
                    </StackPanel>
                    <Button Grid.Column="4" x:Name="BtnPreview" Content="🔍  Preview Records" IsEnabled="False"
                            Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#BEE3F8" BorderThickness="1"
                            Height="40" Padding="16,0" FontWeight="Bold" Cursor="Hand"
                            Click="BtnPreview_Click" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>

            <!-- Step 3: Preview Grid -->
            <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" Padding="16,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="STEP 3 — PREVIEW PARSED RECORDS" FontSize="11" FontWeight="Bold" Foreground="#4A5568"/>
                            <TextBlock x:Name="TxtPreviewCount" Grid.Column="1" Text="" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="PreviewGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" Background="Transparent" BorderThickness="0"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                              HeadersVisibility="Column" ColumnHeaderHeight="36" RowHeight="40"
                              CanUserResizeRows="False">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BIOMETRIC ID" Binding="{Binding BiometricId}" Width="120"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="130"/>
                            <DataGridTextColumn Header="TIME IN" Binding="{Binding TimeInDisplay}" Width="100"/>
                            <DataGridTextColumn Header="TIME OUT" Binding="{Binding TimeOutDisplay}" Width="100"/>
                            <DataGridTextColumn Header="REG HRS" Binding="{Binding RegularHrs, StringFormat={}{0:F2}}" Width="90"/>
                            <DataGridTextColumn Header="OT HRS" Binding="{Binding OtHrs, StringFormat={}{0:F2}}" Width="90"/>
                            <DataGridTemplateColumn Header="MATCH" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock HorizontalAlignment="Center" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="True">
                                                            <Setter Property="Text" Value="✅"/>
                                                            <Setter Property="ToolTip" Value="{Binding MatchedEmployeeName}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsMatched}" Value="False">
                                                            <Setter Property="Text" Value="❌"/>
                                                            <Setter Property="ToolTip" Value="No employee matched this biometric ID"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="MATCHED EMPLOYEE" Binding="{Binding MatchedEmployeeName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Result Banner -->
            <Border x:Name="BannerResult" Grid.Row="3" CornerRadius="6" Padding="14,10"
                    Margin="0,12,0,0" Visibility="Collapsed">
                <TextBlock x:Name="TxtResult" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
            </Border>
        </Grid>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterHint" Text="Select a file and click Preview before importing."
                           FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Close" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0"
                            Height="40" Padding="20,0" FontWeight="SemiBold" Cursor="Hand"
                            Margin="0,0,12,0" Click="BtnClose_Click"/>
                    <Button x:Name="BtnImport" Content="📥  Import to Database" IsEnabled="False"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Height="40" Padding="20,0" Click="BtnImportConfirm_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
