<UserControl x:Class="GB_Payroll_System.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR: Search + Action Buttons -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="#F5F6F8" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Height="38" Width="320" HorizontalAlignment="Left">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#A0AEC0"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" Foreground="#1A202C"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="PlaceholderSearch" Grid.Column="1" Text="Search employee name, code, position..."
                                   FontSize="13" Foreground="#A0AEC0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnShowInactive" Content="Show Inactive" Background="#EDF2F7" Foreground="#4A5568"
                            BorderThickness="0" Height="38" Padding="16,0" FontWeight="SemiBold" Cursor="Hand"
                            Click="BtnShowInactive_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnAddEmployee" Content="➕  Add Employee" Style="{StaticResource PrimaryBtnStyle}"
                            Height="38" Padding="16,0" Click="BtnAddEmployee_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- EMPLOYEE DATA GRID -->
        <DataGrid Grid.Row="1" x:Name="EmployeeGrid"
                  Margin="20" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9FAFB"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                  HeadersVisibility="Column" CanUserResizeRows="False"
                  SelectionChanged="EmployeeGrid_SelectionChanged"
                  MouseDoubleClick="EmployeeGrid_MouseDoubleClick"
                  ColumnHeaderHeight="40" RowHeight="44">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#718096"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#1A202C"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="Foreground" Value="#1A202C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F7FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="EMPLOYEE CODE" Binding="{Binding EmployeeCode}" Width="140"/>
                <DataGridTextColumn Header="LAST NAME" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="140"/>
                <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="150"/>
                <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="160"/>
                <DataGridTextColumn Header="PAY TYPE" Binding="{Binding PayType}" Width="110"/>
                <DataGridTextColumn Header="BASIC RATE (₱)" Binding="{Binding BasicRate, StringFormat={}{0:N2}}" Width="130"/>
                <DataGridTextColumn Header="DATE HIRED" Binding="{Binding DateHired, StringFormat={}{0:MMM dd, yyyy}}" Width="130"/>
                <DataGridTemplateColumn Header="STATUS" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter Property="Background" Value="#C6F6D5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#FED7D7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Text" Value="Active"/>
                                                    <Setter Property="Foreground" Value="#276749"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="Inactive"/>
                                                    <Setter Property="Foreground" Value="#9B2C2C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ACTIONS" Width="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Button Content="✏️ Edit" Tag="{Binding Id}" Click="BtnEdit_Click"
                                        Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                        Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                        Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="📈" Tag="{Binding Id}" Click="BtnPromote_Click"
                                        Background="#FEFCBF" Foreground="#744210" BorderThickness="0"
                                        Height="28" Width="32" FontSize="13"
                                        Cursor="Hand" ToolTip="Salary Promotion"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar at bottom -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,8" Margin="0">
            <TextBlock x:Name="TxtStatusBar" Text="0 employees loaded." FontSize="12" Foreground="#718096"/>
        </Border>
    </Grid>
</UserControl>
