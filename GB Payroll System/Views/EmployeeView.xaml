<UserControl x:Class="GB_Payroll_System.Views.EmployeeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:GB_Payroll_System.Models"
             Background="#F8FAFC"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             FontFamily="Segoe UI Variable, Segoe UI, -apple-system, Arial, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOOLBAR ════════════════════ -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="40" Width="300" Margin="0,0,12,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"
                                 ToolTip="Search employee by full name, code, position, or department"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="PlaceholderSearch" Grid.Column="1" Text="Search name, code, position..."
                                   FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Department & Status Filter Dropdowns -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="CboDepartmentFilter" Height="40" Width="170" Margin="0,0,10,0"
                              FontSize="12" VerticalContentAlignment="Center"
                              ToolTip="Filter employees by department"
                              SelectionChanged="CboDepartmentFilter_SelectionChanged">
                        <ComboBoxItem Content="All Departments" IsSelected="True"/>
                    </ComboBox>

                    <ComboBox x:Name="CboStatusFilter" Height="40" Width="140" Margin="0,0,10,0"
                              FontSize="12" VerticalContentAlignment="Center"
                              ToolTip="Filter by employee active status"
                              SelectionChanged="CboStatusFilter_SelectionChanged">
                        <ComboBoxItem Content="Active Only" IsSelected="True"/>
                        <ComboBoxItem Content="All Employees"/>
                        <ComboBoxItem Content="Inactive Only"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddEmployee" Content="➕ Add Employee (201)" Style="{StaticResource PrimaryBtnStyle}"
                            Height="40" Padding="18,0" FontSize="13" FontWeight="Bold"
                            ToolTip="Register a new employee with complete 201 file, contract, and statutory details"
                            Click="BtnAddEmployee_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ MAIN CONTENT AREA ════════════════════ -->
        <Grid Grid.Row="1" Margin="20,16">
            <!-- EMPLOYEE DATA GRID -->
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>

                <DataGrid x:Name="EmployeeGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          SelectionChanged="EmployeeGrid_SelectionChanged"
                          MouseDoubleClick="EmployeeGrid_MouseDoubleClick"
                          ColumnHeaderHeight="42"
                          RowHeight="48"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Code -->
                        <DataGridTemplateColumn Header="EMP CODE" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EmployeeCode}" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Name -->
                        <DataGridTemplateColumn Header="EMPLOYEE NAME" Width="175">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Department -->
                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="125"/>

                        <!-- Position -->
                        <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="145"/>

                        <!-- Contract Badge -->
                        <DataGridTemplateColumn Header="CONTRACT" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#DBEAFE"/>
                                                <Setter Property="BorderBrush" Value="#BFDBFE"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Probationary">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Fixed-Term">
                                                        <Setter Property="Background" Value="#F3E8FF"/>
                                                        <Setter Property="BorderBrush" Value="#E9D5FF"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Casual">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding ContractTypeDisplay}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1D4ED8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Probationary">
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Fixed-Term">
                                                            <Setter Property="Foreground" Value="#7E22CE"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ContractTypeDisplay}" Value="Casual">
                                                            <Setter Property="Foreground" Value="#475569"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Pay Type -->
                        <DataGridTemplateColumn Header="PAY TYPE" Width="105">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                        <TextBlock Text="{Binding PayTypeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="#334155"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Basic Rate (Right-aligned) -->
                        <DataGridTemplateColumn Header="BASIC RATE" Width="125">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BasicRate, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Date Hired -->
                        <DataGridTemplateColumn Header="DATE HIRED" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateHired, StringFormat='{}{0:MMM dd, yyyy}'}" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Pill Badge -->
                        <DataGridTemplateColumn Header="STATUS" Width="95">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,3" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Background" Value="#FEE2E2"/>
                                                        <Setter Property="BorderBrush" Value="#FECACA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="11" FontWeight="Bold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Text" Value="Inactive"/>
                                                            <Setter Property="Foreground" Value="#B91C1C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Action Buttons -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="✏️ 201 File" Tag="{Binding Id}" Click="BtnEdit_Click"
                                                Background="#EFF6FF" Foreground="#1D4ED8" BorderBrush="#BFDBFE" BorderThickness="1"
                                                Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                                Cursor="Hand" ToolTip="Open full 201 Profile, Contract, Statutory &amp; Document Vault" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="📜 History" Tag="{Binding Id}" Click="BtnHistory_Click"
                                                Background="#F1F5F9" Foreground="#334155" BorderBrush="#E2E8F0" BorderThickness="1"
                                                Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                                Cursor="Hand" ToolTip="View Employment &amp; Re-employment Service Records" Margin="0,0,6,0">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                        <Button Content="📈 Promotion" Tag="{Binding Id}" Click="BtnPromote_Click"
                                                Background="#FEF3C7" Foreground="#B45309" BorderBrush="#FDE68A" BorderThickness="1"
                                                Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                                Cursor="Hand" ToolTip="Apply Salary Increase, Wage Adjustment &amp; Promotion">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ════════════════════ ACTIONABLE EMPTY STATE ════════════════════ -->
            <Border x:Name="PanelEmptyState" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30" MaxWidth="460">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.06" Direction="270" ShadowDepth="4" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="👥" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Employees Found" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="No employee records match your search query or selected department filters. Try clearing your search or register a new employee record."
                               FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnClearFilterEmptyState" Content="Clear Filters" Background="#F1F5F9" Foreground="#334155"
                                BorderBrush="#E2E8F0" BorderThickness="1" Height="36" Padding="16,0" FontWeight="SemiBold"
                                Cursor="Hand" Margin="0,0,10,0" Click="BtnClearFilter_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="➕ Add New Employee" Style="{StaticResource PrimaryBtnStyle}"
                                Height="36" Padding="16,0" FontSize="12.5" FontWeight="Bold"
                                Click="BtnAddEmployee_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════ LOADING INDICATOR OVERLAY ════════════════════ -->
            <Border x:Name="PanelLoading" Background="#80FFFFFF" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Opacity="0.1" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"/>
                        <TextBlock Text="Loading employee 201 records..." FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ════════════════════ STATUS BAR ════════════════════ -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusBar" Text="Ready." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DCFCE7" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtActiveCount" Text="Active: 0" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                    </Border>
                    <Border Background="#F1F5F9" CornerRadius="10" Padding="8,2">
                        <TextBlock x:Name="TxtTotalCount" Text="Total: 0" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
