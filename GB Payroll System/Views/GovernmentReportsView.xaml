<UserControl x:Class="GB_Payroll_System.Views.GovernmentReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Agency tabs + Period Selector -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Agency Toggle -->
                    <Border CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabSss" Content="🛡️ SSS R-3" GroupName="AgencyTab"
                                         IsChecked="True" Checked="AgencyTab_Changed"
                                         Height="36" Padding="12,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton x:Name="TabPhilHealth" Content="🏥 PhilHealth RF-1" GroupName="AgencyTab"
                                         Checked="AgencyTab_Changed"
                                         Height="36" Padding="12,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton x:Name="TabPagIbig" Content="🏠 Pag-IBIG MCRF" GroupName="AgencyTab"
                                         Checked="AgencyTab_Changed"
                                         Height="36" Padding="12,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton x:Name="TabBir" Content="⚖️ BIR 1601-C" GroupName="AgencyTab"
                                         Checked="AgencyTab_Changed"
                                         Height="36" Padding="12,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Filter: Period Selector -->
                    <TextBlock Text="Period:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CboPeriodFilter" Width="180" Height="36" FontSize="12" SelectionChanged="PeriodFilter_Changed"/>
                </StackPanel>

                <!-- Right: Export Button -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnExport" Content="📄  Export CSV Report"
                            Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#BEE3F8" BorderThickness="1"
                            Height="38" Padding="14,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                            Click="BtnExport_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- GRIDS FOR REPORTS -->
        <Grid Grid.Row="1" Margin="20,16,20,0">

            <!-- ── SSS GRID ── -->
            <DataGrid x:Name="SssGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="SSS NUMBER" Binding="{Binding SssNumber}" Width="150"/>
                    <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="GROSS PAY" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="120"/>
                    <DataGridTextColumn Header="EE SHARE" Binding="{Binding EmployeeShare, StringFormat=₱{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="ER SHARE" Binding="{Binding EmployerShare, StringFormat=₱{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="EC SHARE" Binding="{Binding EcContribution, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="TOTAL SSS" Binding="{Binding TotalContribution, StringFormat=₱{0:N2}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── PHILHEALTH GRID ── -->
            <DataGrid x:Name="PhilHealthGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="PHILHEALTH PIN" Binding="{Binding PhilHealthNumber}" Width="160"/>
                    <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="BASIC PAY" Binding="{Binding BasicPay, StringFormat=₱{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="EE PREMIUM" Binding="{Binding EmployeeShare, StringFormat=₱{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="ER PREMIUM" Binding="{Binding EmployerShare, StringFormat=₱{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="TOTAL PREMIUM" Binding="{Binding TotalContribution, StringFormat=₱{0:N2}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── PAG-IBIG GRID ── -->
            <DataGrid x:Name="PagIbigGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="PAG-IBIG ID (MID)" Binding="{Binding PagIbigNumber}" Width="160"/>
                    <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="EE CONTRIBUTION" Binding="{Binding EmployeeShare, StringFormat=₱{0:N2}}" Width="160"/>
                    <DataGridTextColumn Header="ER CONTRIBUTION" Binding="{Binding EmployerShare, StringFormat=₱{0:N2}}" Width="160"/>
                    <DataGridTextColumn Header="TOTAL HDMF" Binding="{Binding TotalContribution, StringFormat=₱{0:N2}}" Width="160"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── BIR 1601-C TAX GRID ── -->
            <DataGrid x:Name="BirTaxGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="TIN" Binding="{Binding TinNumber}" Width="150"/>
                    <DataGridTextColumn Header="EMPLOYEE NAME" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="GROSS COMPENSATION" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="170"/>
                    <DataGridTextColumn Header="NON-TAXABLE (SSS/PH/HDMF)" Binding="{Binding StatutoryDeductions, StringFormat=₱{0:N2}}" Width="190"/>
                    <DataGridTextColumn Header="TAXABLE INCOME" Binding="{Binding TaxableIncome, StringFormat=₱{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="TAX WITHHELD" Binding="{Binding TaxWithheld, StringFormat=₱{0:N2}}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- SUMMARY FOOTER BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#EBF8FF" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtSummaryEe" Text="Employee Share: ₱0.00" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                    </Border>
                    <Border Background="#FEFCBF" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtSummaryEr" Text="Employer Share: ₱0.00" FontSize="12" FontWeight="Bold" Foreground="#744210"/>
                    </Border>
                    <Border Background="#C6F6D5" CornerRadius="4" Padding="10,5">
                        <TextBlock x:Name="TxtSummaryTotal" Text="Total Remittance: ₱0.00" FontSize="13" FontWeight="Bold" Foreground="#276749"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtReportRecordCount" Text="0 records" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
