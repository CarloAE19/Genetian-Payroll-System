<UserControl x:Class="GB_Payroll_System.Views.HolidayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Year Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Year:" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CboYear" Width="100" Height="36" FontSize="13" SelectionChanged="CboYear_SelectionChanged"/>
                    <TextBlock Text="Filter:" FontSize="13" FontWeight="SemiBold" Foreground="#4A5568" VerticalAlignment="Center" Margin="16,0,8,0"/>
                    <ComboBox x:Name="CboTypeFilter" Width="200" Height="36" FontSize="13" SelectionChanged="CboTypeFilter_SelectionChanged">
                        <ComboBoxItem Content="All Types" IsSelected="True"/>
                        <ComboBoxItem Content="Regular Holiday"/>
                        <ComboBoxItem Content="Special Non-Working"/>
                        <ComboBoxItem Content="Special Working"/>
                        <ComboBoxItem Content="Local Special Holiday"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Buttons -->
                <Button Grid.Column="1" x:Name="BtnAddHoliday" Content="➕  Add Holiday"
                        Style="{StaticResource PrimaryBtnStyle}" Height="38" Padding="16,0"
                        Click="BtnAddHoliday_Click"/>
            </Grid>
        </Border>

        <!-- HOLIDAYS DATA GRID -->
        <DataGrid Grid.Row="1" x:Name="HolidayGrid"
                  Margin="20" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single"
                  Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                  RowBackground="White" AlternatingRowBackground="#F9FAFB"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                  HeadersVisibility="Column" CanUserResizeRows="False"
                  ColumnHeaderHeight="40" RowHeight="48">

            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F8FAFC"/>
                    <Setter Property="Foreground" Value="#718096"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>

            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="12,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Foreground" Value="#1A202C"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                            <Setter Property="Foreground" Value="#1A202C"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.CellStyle>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#EBF4FF"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F0F7FF"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat={}{0:MMMM dd, yyyy (ddd)}}" Width="220"/>
                <DataGridTextColumn Header="HOLIDAY NAME" Binding="{Binding Name}" Width="220"/>
                <DataGridTemplateColumn Header="TYPE" Width="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="8,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#E2E8F0"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="RegularHoliday">
                                                <Setter Property="Background" Value="#FED7D7"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="SpecialNonWorking">
                                                <Setter Property="Background" Value="#FEFCBF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="SpecialWorking">
                                                <Setter Property="Background" Value="#C6F6D5"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="LocalSpecialHoliday">
                                                <Setter Property="Background" Value="#BEE3F8"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4A5568"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="RegularHoliday">
                                                    <Setter Property="Text" Value="Regular Holiday"/>
                                                    <Setter Property="Foreground" Value="#9B2C2C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="SpecialNonWorking">
                                                    <Setter Property="Text" Value="Special Non-Working"/>
                                                    <Setter Property="Foreground" Value="#744210"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="SpecialWorking">
                                                    <Setter Property="Text" Value="Special Working"/>
                                                    <Setter Property="Foreground" Value="#276749"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="LocalSpecialHoliday">
                                                    <Setter Property="Text" Value="Local Special"/>
                                                    <Setter Property="Foreground" Value="#1A365D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="WORKED %" Binding="{Binding WorkedMultiplier, StringFormat={}{0:P0}}" Width="100"/>
                <DataGridTextColumn Header="UNWORKED %" Binding="{Binding UnworkedMultiplier, StringFormat={}{0:P0}}" Width="110"/>
                <DataGridTextColumn Header="DECLARED BY" Binding="{Binding DeclaredBy}" Width="*"/>
                <DataGridTemplateColumn Header="ACTIONS" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <Button Content="✏️ Edit" Tag="{Binding Id}" Click="BtnEditHoliday_Click"
                                        Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                        Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                        Cursor="Hand" Margin="0,0,6,0"/>
                                <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteHoliday_Click"
                                        Background="#FFF5F5" Foreground="#C53030" BorderThickness="0"
                                        Height="28" Width="32" FontSize="13" Cursor="Hand"
                                        ToolTip="Remove Holiday"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
