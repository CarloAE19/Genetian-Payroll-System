<Window x:Class="GB_Payroll_System.Views.LeaveApplicationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="File Leave Application" Height="540" Width="540"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🌴  File Leave Application" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Submit a new vacation, sick, or special leave request" FontSize="12" Foreground="#93C5FD"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Employee Code Search -->
                <TextBlock Text="EMPLOYEE CODE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtEmpCode" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,4"
                         ToolTip="Type employee code e.g. EMP-2026-001"
                         TextChanged="TxtEmpCode_TextChanged"/>
                <TextBlock x:Name="TxtEmpName" Text="" FontSize="12" Foreground="#2B6CB0" FontWeight="SemiBold"
                           Margin="2,0,0,14"/>

                <!-- Leave Type -->
                <TextBlock Text="LEAVE TYPE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <ComboBox x:Name="CboLeaveType" Height="44" FontSize="13" Margin="0,0,0,16" SelectionChanged="CboLeaveType_SelectionChanged">
                    <ComboBoxItem Content="Vacation Leave (VL)" IsSelected="True"/>
                    <ComboBoxItem Content="Sick Leave (SL)"/>
                    <ComboBoxItem Content="Emergency Leave (EL)"/>
                    <ComboBoxItem Content="Maternity Leave (ML)"/>
                    <ComboBoxItem Content="Paternity Leave (PL)"/>
                    <ComboBoxItem Content="Solo Parent Leave"/>
                    <ComboBoxItem Content="Bereavement Leave"/>
                </ComboBox>

                <!-- Date Range -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="START DATE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpStart" Height="44" FontSize="13" SelectedDateChanged="Date_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="END DATE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <DatePicker x:Name="DpEnd" Height="44" FontSize="13" SelectedDateChanged="Date_Changed"/>
                    </StackPanel>
                </Grid>

                <!-- Days Count (Auto-calculated, editable for half day 0.5) -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="NUMBER OF DAYS *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtDaysCount" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. 1.0 or 0.5 for half day"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                        <CheckBox x:Name="ChkHalfDay" Content="Half Day (0.5 day)" FontSize="12" FontWeight="Bold" Foreground="#4A5568"
                                  Checked="ChkHalfDay_Checked" Unchecked="ChkHalfDay_Unchecked" Margin="0,0,0,12"/>
                    </StackPanel>
                </Grid>

                <!-- Reason -->
                <TextBlock Text="REASON FOR LEAVE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <Border Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,0,8">
                    <TextBox x:Name="TxtReason" Height="64" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="Transparent" BorderThickness="0" FontSize="13"/>
                </Border>

                <!-- Error Banner -->
                <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0"
                        Height="40" Padding="20,0" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="💾  Submit Leave Application" Style="{StaticResource PrimaryBtnStyle}"
                        Height="40" Padding="20,0" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
