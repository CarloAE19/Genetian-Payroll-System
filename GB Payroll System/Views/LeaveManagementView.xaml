<UserControl x:Class="GB_Payroll_System.Views.LeaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Tabs & Filters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabApplications" Content="📋  Leave Applications" GroupName="LeaveTab"
                                         IsChecked="True" Checked="LeaveTab_Changed"
                                         Height="36" Padding="14,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>

                            <RadioButton x:Name="TabBalances" Content="📊  Leave Balances &amp; Carry-Over" GroupName="LeaveTab"
                                         Checked="LeaveTab_Changed"
                                         Height="36" Padding="14,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Applications Filter (Status) -->
                    <StackPanel x:Name="StatusFilterPanel" Orientation="Horizontal">
                        <TextBlock Text="Status:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CboStatusFilter" Width="140" Height="36" FontSize="12" SelectionChanged="StatusFilter_Changed">
                            <ComboBoxItem Content="All Status" IsSelected="True"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Approved"/>
                            <ComboBoxItem Content="Rejected"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Balances Filter (Year) -->
                    <StackPanel x:Name="YearFilterPanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="Year:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CboYearFilter" Width="110" Height="36" FontSize="12" SelectionChanged="YearFilter_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCarryOver" Content="🔄  Run Year-End Carry-Over"
                            Background="#EBF8FF" Foreground="#2B6CB0" BorderBrush="#BEE3F8" BorderThickness="1"
                            Height="38" Padding="14,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                            Visibility="Collapsed" Click="BtnCarryOver_Click" Margin="0,0,8,0"/>

                    <Button x:Name="BtnFileLeave" Content="➕  File Leave Application"
                            Style="{StaticResource PrimaryBtnStyle}"
                            Height="38" Padding="16,0" Click="BtnFileLeave_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENT PANELS -->
        <Grid Grid.Row="1" Margin="20,16,20,0">

            <!-- ── TAB 1: APPLICATIONS GRID ── -->
            <DataGrid x:Name="ApplicationsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="48" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="160"/>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="130"/>
                    <DataGridTextColumn Header="LEAVE TYPE" Binding="{Binding TypeDisplay}" Width="170"/>
                    <DataGridTextColumn Header="DATE RANGE" Binding="{Binding DateRangeDisplay}" Width="170"/>
                    <DataGridTextColumn Header="DAYS" Binding="{Binding DaysCount, StringFormat={}{0:F1}}" Width="70"/>
                    <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="*"/>

                    <!-- STATUS BADGE -->
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                    <Setter Property="Background" Value="#C6F6D5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="Background" Value="#FEFCBF"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                    <Setter Property="Background" Value="#FED7D7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                        <Setter Property="Foreground" Value="#276749"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                        <Setter Property="Foreground" Value="#744210"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                        <Setter Property="Foreground" Value="#9B2C2C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ACTIONS -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <Button Content="✔️ Approve" Tag="{Binding Id}" Click="BtnApprove_Click"
                                            Background="#C6F6D5" Foreground="#276749" BorderThickness="0"
                                            Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                            Margin="0,0,4,0"/>
                                    <Button Content="✖️ Reject" Tag="{Binding Id}" Click="BtnReject_Click"
                                            Background="#FED7D7" Foreground="#9B2C2C" BorderThickness="0"
                                            Height="28" Padding="8,0" FontSize="11" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── TAB 2: BALANCES GRID ── -->
            <DataGrid x:Name="BalancesGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" RowHeight="44" ColumnHeaderHeight="40">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="EMP CODE" Binding="{Binding EmployeeCode}" Width="120"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="170"/>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="130"/>
                    <DataGridTextColumn Header="VL TOTAL" Binding="{Binding VacationLeaveTotal, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="VL USED" Binding="{Binding VacationLeaveUsed, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="CARRY-OVER" Binding="{Binding CarryOverDays, StringFormat={}{0:F1}}" Width="110"/>
                    <DataGridTextColumn Header="VL BAL" Binding="{Binding VacationLeaveBalance, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="SL TOTAL" Binding="{Binding SickLeaveTotal, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="SL USED" Binding="{Binding SickLeaveUsed, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="SL BAL" Binding="{Binding SickLeaveBalance, StringFormat={}{0:F1}}" Width="90"/>
                    <DataGridTextColumn Header="EL BAL" Binding="{Binding EmergencyLeaveBalance, StringFormat={}{0:F1}}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>

        <!-- SUMMARY FOOTER BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Background="#FEFCBF" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtPendingCount" Text="Pending: 0" FontSize="12" FontWeight="Bold" Foreground="#744210"/>
                    </Border>
                    <Border Background="#C6F6D5" CornerRadius="4" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtApprovedCount" Text="Approved: 0" FontSize="12" FontWeight="Bold" Foreground="#276749"/>
                    </Border>
                    <Border Background="#FED7D7" CornerRadius="4" Padding="10,4">
                        <TextBlock x:Name="TxtRejectedCount" Text="Rejected: 0" FontSize="12" FontWeight="Bold" Foreground="#9B2C2C"/>
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtRecordCount" Text="0 items" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
