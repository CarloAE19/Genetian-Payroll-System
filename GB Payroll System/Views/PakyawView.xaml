<UserControl x:Class="GB_Payroll_System.Views.PakyawView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOOLBAR -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: tabs + filters -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tab toggle: Catalog / Output Entries -->
                    <Border CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabCatalog" Content="📦  Task Catalog" GroupName="PakyawTab"
                                         IsChecked="True" Checked="Tab_Changed"
                                         Height="36" Padding="14,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                            <RadioButton x:Name="TabOutput" Content="📝  Daily Output Entries" GroupName="PakyawTab"
                                         Checked="Tab_Changed"
                                         Height="36" Padding="14,0" FontWeight="Bold" FontSize="12"
                                         Cursor="Hand" BorderThickness="0">
                                <RadioButton.Style>
                                    <Style TargetType="RadioButton">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#718096"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="RadioButton">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                                                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                                            <Setter Property="Foreground" Value="White"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </RadioButton.Style>
                            </RadioButton>
                        </StackPanel>
                    </Border>

                    <!-- Date range (shown only on Output tab) -->
                    <StackPanel x:Name="DateRangePanel" Orientation="Horizontal" Visibility="Collapsed">
                        <TextBlock Text="From:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker x:Name="DpFrom" Width="130" Height="36" FontSize="13" SelectedDateChanged="OutputFilter_Changed"/>
                        <TextBlock Text="To:" FontSize="12" FontWeight="Bold" Foreground="#4A5568" VerticalAlignment="Center" Margin="10,0,6,0"/>
                        <DatePicker x:Name="DpTo" Width="130" Height="36" FontSize="13" SelectedDateChanged="OutputFilter_Changed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: action button -->
                <Button x:Name="BtnAdd" Grid.Column="1" Content="➕  Add Task" Style="{StaticResource PrimaryBtnStyle}"
                        Height="38" Padding="16,0" Click="BtnAdd_Click"/>
            </Grid>
        </Border>

        <!-- CONTENT AREA: two grids, one visible at a time -->
        <Grid Grid.Row="1" Margin="20,16,20,0">

            <!-- ── CATALOG GRID ─────────────────────────────────── -->
            <DataGrid x:Name="CatalogGrid" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      ColumnHeaderHeight="40" RowHeight="46"
                      MouseDoubleClick="CatalogGrid_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="TASK CODE" Binding="{Binding TaskCode}" Width="150"/>
                    <DataGridTextColumn Header="TASK / WORK NAME" Binding="{Binding TaskName}" Width="*"/>
                    <DataGridTextColumn Header="UNIT OF MEASURE" Binding="{Binding UnitOfMeasure}" Width="160"/>
                    <DataGridTextColumn Header="RATE PER UNIT (₱)" Binding="{Binding RatePerUnit, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="10,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#C6F6D5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Background" Value="#FED7D7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Text" Value="Active"/>
                                                        <Setter Property="Foreground" Value="#276749"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Inactive"/>
                                                        <Setter Property="Foreground" Value="#9B2C2C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ACTIONS" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="10,0">
                                    <Button Content="✏️ Edit" Tag="{Binding Id}" Click="BtnEditTask_Click"
                                            Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                            Height="28" Padding="10,0" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                            Margin="0,0,6,0"/>
                                    <Button Content="📝" Tag="{Binding Id}" Click="BtnLogOutput_Click"
                                            Background="#FEFCBF" Foreground="#744210" BorderThickness="0"
                                            Height="28" Width="30" FontSize="13" Cursor="Hand"
                                            ToolTip="Log Today's Output"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ── OUTPUT ENTRIES GRID ──────────────────────────── -->
            <DataGrid x:Name="OutputGrid" Visibility="Collapsed" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      ColumnHeaderHeight="40" RowHeight="46">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding WorkDate, StringFormat='MMM dd, yyyy (ddd)'}" Width="180"/>
                    <DataGridTextColumn Header="EMPLOYEE CODE" Binding="{Binding EmployeeCode}" Width="130"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="160"/>
                    <DataGridTextColumn Header="TASK" Binding="{Binding TaskName}" Width="160"/>
                    <DataGridTextColumn Header="QTY COMPLETED" Binding="{Binding QuantityCompleted, StringFormat={}{0:N2}}" Width="130"/>
                    <DataGridTextColumn Header="UNIT" Binding="{Binding UnitOfMeasure}" Width="90"/>
                    <DataGridTextColumn Header="RATE (₱)" Binding="{Binding UnitRate, StringFormat={}{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="TOTAL EARNINGS (₱)" Binding="{Binding TotalEarnings, StringFormat={}{0:N2}}" Width="150"/>
                    <DataGridTextColumn Header="RECORDED BY" Binding="{Binding RecordedByUsername}" Width="*"/>
                    <DataGridTemplateColumn Header="" Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🗑️" Tag="{Binding Id}" Click="BtnDeleteEntry_Click"
                                        Background="#FFF5F5" Foreground="#C53030" BorderThickness="0"
                                        Height="28" Width="32" FontSize="13" Cursor="Hand"
                                        ToolTip="Delete Entry" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- SUMMARY BAR -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Text="" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTotalEarnings" Grid.Column="1"
                           Text="" FontSize="14" FontWeight="Bold" Foreground="#2F855A" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
