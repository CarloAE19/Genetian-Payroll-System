<Window x:Class="GB_Payroll_System.Views.PayrollPeriodDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New Payroll Period" Height="380" Width="480"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <TextBlock Text="New Payroll Cutoff Period" FontSize="18" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="24,20">
            <!-- Quick Fill -->
            <TextBlock Text="QUICK FILL" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="1st Half (1–15)" Background="#EBF8FF" Foreground="#2B6CB0"
                        BorderBrush="#BEE3F8" BorderThickness="1" Height="36" Padding="14,0"
                        FontWeight="Bold" Cursor="Hand" Margin="0,0,8,0" Click="BtnFirstHalf_Click"/>
                <Button Content="2nd Half (16–End)" Background="#EBF8FF" Foreground="#2B6CB0"
                        BorderBrush="#BEE3F8" BorderThickness="1" Height="36" Padding="14,0"
                        FontWeight="Bold" Cursor="Hand" Click="BtnSecondHalf_Click"/>
            </StackPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="START DATE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpStart" Height="44" FontSize="13" SelectedDateChanged="Dates_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="END DATE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                    <DatePicker x:Name="DpEnd" Height="44" FontSize="13" SelectedDateChanged="Dates_Changed"/>
                </StackPanel>
            </Grid>

            <TextBlock Text="PAYOUT DATE *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
            <DatePicker x:Name="DpPayout" Height="44" FontSize="13" Margin="0,0,0,14"/>

            <TextBlock Text="PERIOD CODE" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtCode" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,8"
                     ToolTip="Auto-generated, or override e.g. 2026-07-2"/>

            <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0"
                        Height="40" Padding="20,0" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="💾  Create Period" Style="{StaticResource PrimaryBtnStyle}"
                        Height="40" Padding="20,0" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
