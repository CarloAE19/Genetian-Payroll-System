<UserControl x:Class="GB_Payroll_System.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6F9">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: Payroll Periods ═══ -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Period Panel Header -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="PAYROLL PERIODS" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,10"/>
                        <Button x:Name="BtnNewPeriod" Content="➕  New Cutoff Period"
                                Style="{StaticResource PrimaryBtnStyle}" Height="36" FontSize="12"
                                Click="BtnNewPeriod_Click"/>
                    </StackPanel>
                </Border>

                <!-- Periods List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ListBox x:Name="PeriodList" BorderThickness="0" Background="Transparent"
                             SelectionChanged="PeriodList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="Transparent"
                                                    BorderBrush="#EDF2F7" BorderThickness="0,0,0,1"
                                                    Padding="16,14">
                                                <ContentPresenter/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="SelectionStates">
                                                        <VisualState x:Name="Selected">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="bd" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                        <DiscreteObjectKeyFrame.Value>
                                                                            <SolidColorBrush Color="#EBF4FF"/>
                                                                        </DiscreteObjectKeyFrame.Value>
                                                                    </DiscreteObjectKeyFrame>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Unselected"/>
                                                        <VisualState x:Name="SelectedUnfocused">
                                                            <Storyboard>
                                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="bd" Storyboard.TargetProperty="Background">
                                                                    <DiscreteObjectKeyFrame KeyTime="0">
                                                                        <DiscreteObjectKeyFrame.Value>
                                                                            <SolidColorBrush Color="#EBF4FF"/>
                                                                        </DiscreteObjectKeyFrame.Value>
                                                                    </DiscreteObjectKeyFrame>
                                                                </ObjectAnimationUsingKeyFrames>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding PeriodCode}" FontSize="13" FontWeight="Bold" Foreground="#1A202C"/>
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsClosed}" Value="False">
                                                            <Setter Property="Background" Value="#FEFCBF"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsClosed}" Value="True">
                                                                <Setter Property="Text" Value="Closed"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsClosed}" Value="False">
                                                                <Setter Property="Text" Value="Open"/>
                                                                <Setter Property="Foreground" Value="#744210"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" FontSize="12" Foreground="#718096" Margin="0,3,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:MMM dd} – {1:MMM dd, yyyy}">
                                                <Binding Path="StartDate"/>
                                                <Binding Path="EndDate"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Row="2" FontSize="11" Foreground="#A0AEC0" Margin="0,2,0,0">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0:Payout: MMM dd, yyyy}">
                                                <Binding Path="PayoutDate"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ═══ RIGHT PANEL: Payroll Run Grid ═══ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Run Toolbar -->
            <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtPeriodLabel" Text="Select a payroll period on the left to begin."
                                   FontSize="15" FontWeight="Bold" Foreground="#1A202C"/>
                        <TextBlock x:Name="TxtPeriodSub" Text="" FontSize="12" Foreground="#718096"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnRecompute" Content="⚙️  Run Payroll" IsEnabled="False"
                                Style="{StaticResource PrimaryBtnStyle}"
                                Height="38" Padding="16,0" FontSize="12" Margin="0,0,10,0"
                                Click="BtnRecompute_Click"/>
                        <Button x:Name="BtnClose" Content="🔒  Close Period" IsEnabled="False"
                                Background="#2F855A" Foreground="White" BorderThickness="0"
                                Height="38" Padding="16,0" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                Margin="0,0,10,0" Click="BtnClosePeriod_Click"/>
                        <Button x:Name="BtnPrintAll" Content="🖨️  Print All Payslips" IsEnabled="False"
                                Background="#2B6CB0" Foreground="White" BorderThickness="0"
                                Height="38" Padding="16,0" FontSize="12" FontWeight="Bold" Cursor="Hand"
                                Click="BtnPrintAll_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Payroll DataGrid -->
            <DataGrid Grid.Row="1" x:Name="PayrollGrid"
                      Margin="20,16,20,0" AutoGenerateColumns="False"
                      IsReadOnly="True" SelectionMode="Single"
                      Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                      RowBackground="White" AlternatingRowBackground="#F9FAFB"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                      HeadersVisibility="Column" CanUserResizeRows="False"
                      ColumnHeaderHeight="40" RowHeight="46">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#718096"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="FontSize" Value="13"/>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F0F7FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="CODE" Binding="{Binding EmployeeCode}" Width="110"/>
                    <DataGridTextColumn Header="NAME" Binding="{Binding FullName}" Width="160"/>
                    <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="130"/>
                    <DataGridTextColumn Header="BASIC PAY" Binding="{Binding BasicPay, StringFormat=₱{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="PAKYAW" Binding="{Binding PakyawPay, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="OT PAY" Binding="{Binding OvertimePay, StringFormat=₱{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="GROSS PAY" Binding="{Binding GrossPay, StringFormat=₱{0:N2}}" Width="110"/>
                    <DataGridTextColumn Header="SSS" Binding="{Binding SssEmployee, StringFormat=₱{0:N2}}" Width="85"/>
                    <DataGridTextColumn Header="PHILHEALTH" Binding="{Binding PhilHealthEmployee, StringFormat=₱{0:N2}}" Width="100"/>
                    <DataGridTextColumn Header="PAG-IBIG" Binding="{Binding PagIbigEmployee, StringFormat=₱{0:N2}}" Width="90"/>
                    <DataGridTextColumn Header="TAX" Binding="{Binding WithholdingTax, StringFormat=₱{0:N2}}" Width="85"/>
                    <DataGridTextColumn Header="NET PAY" Binding="{Binding NetPay, StringFormat=₱{0:N2}}" Width="110"/>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="🧾 Payslip" Tag="{Binding EmployeeId}" Click="BtnPayslip_Click"
                                        Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                        Height="30" Padding="8,0" FontSize="11" FontWeight="Bold"
                                        Cursor="Hand" Margin="4,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Totals Summary Bar -->
            <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Background="#EBF8FF" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtTotalGross" Text="Total Gross: ₱0.00" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                        </Border>
                        <Border Background="#FED7D7" CornerRadius="4" Padding="10,5" Margin="0,0,10,0">
                            <TextBlock x:Name="TxtTotalDeductions" Text="Total Deductions: ₱0.00" FontSize="12" FontWeight="Bold" Foreground="#9B2C2C"/>
                        </Border>
                        <Border Background="#C6F6D5" CornerRadius="4" Padding="10,5">
                            <TextBlock x:Name="TxtTotalNet" Text="Total Net Payroll: ₱0.00" FontSize="13" FontWeight="Bold" Foreground="#276749"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtEmployeeCount" Grid.Column="1"
                               FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
