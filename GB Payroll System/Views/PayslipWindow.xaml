<Window x:Class="GB_Payroll_System.Views.PayslipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payslip" Height="740" Width="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        MinWidth="520" MinHeight="640"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="🖨️  Print Payslip" Style="{StaticResource PrimaryBtnStyle}"
                        Height="36" Padding="16,0" FontSize="12" Click="BtnPrint_Click" Margin="0,0,8,0"/>
                <Button Content="Close" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0"
                        Height="36" Padding="16,0" FontWeight="SemiBold" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Border>

        <!-- Payslip Document -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28">
            <Border x:Name="PayslipDocument" Background="White" CornerRadius="2"
                    BorderBrush="#CBD5E0" BorderThickness="1" Padding="36">
                <StackPanel>

                    <!-- Company Header -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="GENETIAN PAYROLL SYSTEM" FontSize="20" FontWeight="Bold"
                                       Foreground="#0A4D9C" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtPeriodHeader" Text="" FontSize="12" Foreground="#4A5568" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Image Grid.Column="1" Source="/Assets/logo.png"
                               Width="56" Height="56" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="2" Background="#0A4D9C" Margin="0,10,0,16" CornerRadius="1"/>

                    <!-- Payslip Title -->
                    <TextBlock Text="PAY SLIP" FontSize="15" FontWeight="Bold" Foreground="#1A202C"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Employee Info Box -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="EMPLOYEE NAME" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock x:Name="TxtEmpName" FontSize="14" FontWeight="Bold" Foreground="#1A202C" Margin="0,3,0,8"/>
                                <TextBlock Text="DEPARTMENT" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock x:Name="TxtDept" FontSize="13" Foreground="#1A202C" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="EMPLOYEE CODE" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock x:Name="TxtCode" FontSize="14" FontWeight="Bold" Foreground="#1A202C" Margin="0,3,0,8"/>
                                <TextBlock Text="POSITION" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock x:Name="TxtPosition" FontSize="13" Foreground="#1A202C" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Earnings Section -->
                    <TextBlock Text="EARNINGS" FontSize="11" FontWeight="Bold" Foreground="#0A4D9C"
                               Background="#EBF4FF" Padding="10,6" Margin="0,0,0,1"/>
                    <ItemsControl x:Name="EarningsItems" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#1A202C"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=₱{0:N2}}"
                                               FontSize="13" Foreground="#1A202C" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Gross Pay -->
                    <Border Background="#EBF4FF" Margin="0,4,0,12" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="GROSS PAY" FontSize="13" FontWeight="Bold" Foreground="#0A4D9C"/>
                            <TextBlock x:Name="TxtGross" Grid.Column="1" FontSize="14" FontWeight="Bold"
                                       Foreground="#0A4D9C" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Deductions Section -->
                    <TextBlock Text="DEDUCTIONS" FontSize="11" FontWeight="Bold" Foreground="#9B2C2C"
                               Background="#FFF5F5" Padding="10,6" Margin="0,0,0,1"/>
                    <ItemsControl x:Name="DeductionItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="13" Foreground="#1A202C"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Amount, StringFormat=₱{0:N2}}"
                                               FontSize="13" Foreground="#C53030" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Total Deductions -->
                    <Border Background="#FFF5F5" Margin="0,4,0,12" Padding="10,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL DEDUCTIONS" FontSize="13" FontWeight="Bold" Foreground="#9B2C2C"/>
                            <TextBlock x:Name="TxtTotalDed" Grid.Column="1" FontSize="14" FontWeight="Bold"
                                       Foreground="#9B2C2C" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- NET PAY -->
                    <Border Background="#0A4D9C" CornerRadius="6" Padding="16,14" Margin="0,4,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="NET PAY" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtNetPay" Grid.Column="1" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        </Grid>
                    </Border>

                    <!-- Footer signature line -->
                    <Border BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border BorderBrush="#1A202C" BorderThickness="0,0,0,1" Width="180" Height="28"/>
                                <TextBlock Text="Employee Signature" FontSize="11" Foreground="#718096" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <Border BorderBrush="#1A202C" BorderThickness="0,0,0,1" Width="180" Height="28"/>
                                <TextBlock Text="Authorized Signatory" FontSize="11" Foreground="#718096" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="TxtFooterNote" Text="" FontSize="10" Foreground="#A0AEC0"
                               HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <TextBlock x:Name="TxtPayslipNote" Text="" FontSize="12" Foreground="#718096" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
