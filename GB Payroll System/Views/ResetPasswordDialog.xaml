<Window x:Class="GB_Payroll_System.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="360" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔑  Reset Account Password" FontSize="17" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TxtSubtitle" Text="Enter a secure new password for user" FontSize="11" Foreground="#93C5FD"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="NEW PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtNewPassword" Height="42" FontSize="13" Margin="0,0,0,14"
                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"
                         ToolTip="Minimum 6 characters"/>

            <TextBlock Text="CONFIRM NEW PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtConfirm" Height="42" FontSize="13" Margin="0,0,0,14"
                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"
                         ToolTip="Must match the new password"/>

            <!-- Error Banner -->
            <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#475569" BorderThickness="0"
                        Height="38" Padding="18,0" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,10,0" IsCancel="True" Click="BtnCancel_Click"/>
                <Button Content="🔑  Update Password" Style="{StaticResource PrimaryBtnStyle}"
                        Height="38" Padding="18,0" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
