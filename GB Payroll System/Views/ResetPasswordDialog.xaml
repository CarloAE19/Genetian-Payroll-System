<Window x:Class="GB_Payroll_System.Views.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reset Password" Height="320" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F4F6F9">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="🔑  Reset Password" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TxtSubtitle" Text="" FontSize="12" Foreground="#93C5FD"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <StackPanel Grid.Row="1" Margin="24,20">
            <TextBlock Text="NEW PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtNewPassword" Height="44" FontSize="13" Margin="0,0,0,14"
                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"/>

            <TextBlock Text="CONFIRM NEW PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
            <PasswordBox x:Name="TxtConfirm" Height="44" FontSize="13" Margin="0,0,0,14"
                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"/>

            <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#4A5568" BorderThickness="0"
                        Height="40" Padding="20,0" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="🔑  Update Password" Style="{StaticResource PrimaryBtnStyle}"
                        Height="40" Padding="20,0" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
