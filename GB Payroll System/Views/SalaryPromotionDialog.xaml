<Window x:Class="GB_Payroll_System.Views.SalaryPromotionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salary Promotion" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F4F6F9">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtDialogTitle" Text="Salary Promotion" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="TxtEmployeeSubtitle" Text="" FontSize="12" Foreground="#93C5FD"/>
            </StackPanel>
        </Border>

        <!-- BODY -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Current Salary Info Card -->
                <Border Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CURRENT POSITION" FontSize="11" FontWeight="Bold" Foreground="#2B6CB0"/>
                            <TextBlock x:Name="TxtCurrentPosition" Text="—" FontSize="16" FontWeight="Bold" Foreground="#1A202C" Margin="0,4,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="CURRENT BASIC RATE (₱)" FontSize="11" FontWeight="Bold" Foreground="#2B6CB0"/>
                            <TextBlock x:Name="TxtCurrentRate" Text="₱0.00" FontSize="20" FontWeight="Bold" Foreground="#0A4D9C" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- New Position -->
                <TextBlock Text="NEW POSITION / JOB TITLE" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNewPosition" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,16"/>

                <!-- New Rate -->
                <TextBlock x:Name="TxtNewRateLabel" Text="NEW BASIC RATE (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtNewRate" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,16"/>

                <!-- Effective Date -->
                <TextBlock Text="EFFECTIVE DATE" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <DatePicker x:Name="DpEffectiveDate" Height="44" FontSize="13" Margin="0,0,0,16"/>

                <!-- Reason -->
                <TextBlock Text="REASON / REMARKS" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtReason" Height="80" Style="{StaticResource ModernInputStyle}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" Padding="12,10" Margin="0,0,0,16"/>

                <!-- History Section -->
                <TextBlock Text="📋  PROMOTION HISTORY" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,10"/>
                <DataGrid x:Name="HistoryGrid" Height="130" AutoGenerateColumns="False"
                          IsReadOnly="True" BorderBrush="#E2E8F0" BorderThickness="1"
                          Background="White" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                          ColumnHeaderHeight="32" RowHeight="32">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#718096"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="10"/>
                            <Setter Property="Padding" Value="10,0"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="EFFECTIVE DATE" Binding="{Binding EffectiveDate, StringFormat={}{0:MMM dd, yyyy}}" Width="130"/>
                        <DataGridTextColumn Header="POSITION" Binding="{Binding NewPosition}" Width="150"/>
                        <DataGridTextColumn Header="NEW RATE (₱)" Binding="{Binding NewRate, StringFormat={}{0:N2}}" Width="120"/>
                        <DataGridTextColumn Header="APPROVED BY" Binding="{Binding ApprovedByUsername}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Error Banner -->
                <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#4A5568"
                        BorderThickness="0" Height="40" Padding="20,0" FontWeight="SemiBold"
                        Cursor="Hand" Margin="0,0,12,0" Click="BtnCancel_Click"/>
                <Button Content="📈  Apply Promotion" Style="{StaticResource PrimaryBtnStyle}"
                        Height="40" Padding="20,0" Click="BtnApply_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
