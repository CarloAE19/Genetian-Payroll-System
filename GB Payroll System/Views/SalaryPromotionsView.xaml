<UserControl x:Class="GB_Payroll_System.Views.SalaryPromotionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             FontFamily="Segoe UI Variable, Segoe UI, -apple-system, Arial, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOP KPI CARDS ════════════════════ -->
        <UniformGrid Grid.Row="0" Columns="4" Margin="20,16,20,0">
            <!-- Card 1: Total Promotions -->
            <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL PROMOTIONS" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalPromotionsKpi" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,2"/>
                        <TextBlock Text="All-time adjustments" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#DBEAFE" VerticalAlignment="Top">
                        <TextBlock Text="📈" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 2: Average Increase % -->
            <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AVG. INCREASE RATE" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtAvgIncreaseKpi" Text="+0.0%" FontSize="22" FontWeight="Bold" Foreground="#B45309" Margin="0,6,0,2"/>
                        <TextBlock Text="Average raise percentage" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#FEF3C7" VerticalAlignment="Top">
                        <TextBlock Text="📊" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 3: Total Monthly Increment -->
            <Border Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL WAGE INCREMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtTotalIncrementKpi" Text="₱0.00" FontSize="20" FontWeight="Bold" Foreground="#15803D" Margin="0,6,0,2"/>
                        <TextBlock Text="Monthly payroll impact" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#DCFCE7" VerticalAlignment="Top">
                        <TextBlock Text="💵" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Card 4: Latest Promotion Date -->
            <Border Background="White" CornerRadius="10" Padding="18" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="LATEST ADJUSTMENT" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock x:Name="TxtLatestDateKpi" Text="None" FontSize="16" FontWeight="Bold" Foreground="#4338CA" Margin="0,8,0,2"/>
                        <TextBlock Text="Most recent wage audit" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="40" Height="40" CornerRadius="8" Background="#E0E7FF" VerticalAlignment="Top">
                        <TextBlock Text="🗓️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- ════════════════════ TOOLBAR ════════════════════ -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,1" Padding="20,12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Height="40" Width="300" Margin="0,0,12,0">
                    <Grid Margin="12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
                        <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" FontSize="13" Foreground="#0F172A"
                                 ToolTip="Search promotion records by employee name, code, position, or approver"
                                 TextChanged="TxtSearch_TextChanged"/>
                        <TextBlock x:Name="PlaceholderSearch" Grid.Column="1" Text="Search promotion records..."
                                   FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- Department Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="CboDepartmentFilter" Height="40" Width="180"
                              FontSize="12" VerticalContentAlignment="Center"
                              ToolTip="Filter promotions by department"
                              SelectionChanged="CboDepartmentFilter_SelectionChanged">
                        <ComboBoxItem Content="All Departments" IsSelected="True"/>
                    </ComboBox>
                </StackPanel>

                <!-- Action Button -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnAddPromotion" Content="📈 + Record Salary Promotion" Style="{StaticResource PrimaryBtnStyle}"
                            Height="40" Padding="18,0" FontSize="13" FontWeight="Bold"
                            ToolTip="Apply a salary increase, wage revision, or position upgrade to an employee"
                            Click="BtnAddPromotion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════ PROMOTIONS DATA GRID ════════════════════ -->
        <Grid Grid.Row="2" Margin="20,16">
            <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" Opacity="0.04" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                </Border.Effect>

                <DataGrid x:Name="PromotionsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="Transparent"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          ColumnHeaderHeight="42"
                          RowHeight="48"
                          SnapsToDevicePixels="True"
                          UseLayoutRounding="True">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="#0F172A"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EFF6FF"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>

                    <DataGrid.Columns>
                        <!-- Effective Date -->
                        <DataGridTemplateColumn Header="EFFECTIVE DATE" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EffectiveDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="SemiBold" Foreground="#334155" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Employee Name & Code -->
                        <DataGridTemplateColumn Header="EMPLOYEE" Width="185">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding EmployeeFullName}" FontWeight="Bold" Foreground="#0F172A" FontSize="13"/>
                                        <TextBlock Text="{Binding EmployeeCode}" FontSize="11" Foreground="#64748B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Department -->
                        <DataGridTextColumn Header="DEPARTMENT" Binding="{Binding Department}" Width="125"/>

                        <!-- Position Progression -->
                        <DataGridTemplateColumn Header="POSITION PROGRESSION" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PositionProgressionDisplay}" Foreground="#1E293B" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12.5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Previous Rate -->
                        <DataGridTemplateColumn Header="PREVIOUS RATE" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding PreviousRate, StringFormat='₱{0:N2}'}" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12.5"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- New Rate -->
                        <DataGridTemplateColumn Header="NEW RATE" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding NewRate, StringFormat='₱{0:N2}'}" FontWeight="Bold" Foreground="#0A4D9C" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="13"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Increment Badge -->
                        <DataGridTemplateColumn Header="INCREMENT" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1">
                                        <TextBlock Text="{Binding IncreaseBadgeDisplay}" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Reason / Remarks -->
                        <DataGridTextColumn Header="REASON / REMARKS" Binding="{Binding Reason}" Width="*"/>

                        <!-- Approved By -->
                        <DataGridTemplateColumn Header="APPROVED BY" Width="115">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F5F9">
                                        <TextBlock Text="{Binding ApprovedByUsername}" FontSize="11" Foreground="#475569" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ════════════════════ ACTIONABLE EMPTY STATE ════════════════════ -->
            <Border x:Name="PanelEmptyState" Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                    Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,30" MaxWidth="460">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.06" Direction="270" ShadowDepth="4" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#FEF3C7" CornerRadius="30" Width="60" Height="60" HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock Text="📈" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="No Promotion Records Found" FontSize="16" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="No salary promotion or wage adjustment history records match your search or filter. You can apply a new salary increment to any employee."
                               FontSize="12.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnClearFilterEmptyState" Content="Clear Filters" Background="#F1F5F9" Foreground="#334155"
                                BorderBrush="#E2E8F0" BorderThickness="1" Height="36" Padding="16,0" FontWeight="SemiBold"
                                Cursor="Hand" Margin="0,0,10,0" Click="BtnClearFilter_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="📈 + Record Promotion" Style="{StaticResource PrimaryBtnStyle}"
                                Height="36" Padding="16,0" FontSize="12.5" FontWeight="Bold"
                                Click="BtnAddPromotion_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ════════════════════ LOADING OVERLAY ════════════════════ -->
            <Border x:Name="PanelLoading" Background="#80FFFFFF" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" Opacity="0.1" Direction="270" ShadowDepth="2" Color="#0F172A"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="20" Height="20" Margin="0,0,12,0"/>
                        <TextBlock Text="Loading salary promotion audit records..." FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>

        <!-- ════════════════════ STATUS BAR ════════════════════ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatusBar" Text="Ready." FontSize="12" Foreground="#64748B" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="#F1F5F9" CornerRadius="10" Padding="8,2">
                    <TextBlock x:Name="TxtTotalCount" Text="Total Records: 0" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
