<UserControl x:Class="GB_Payroll_System.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Tab Bar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="TabUsers" Content="👤  User Accounts" GroupName="SettingsTab"
                                 IsChecked="True" Checked="Tab_Changed"
                                 Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                 Style="{DynamicResource SettingsTabRadioStyle}"/>

                    <RadioButton x:Name="TabCompany" Content="🏢  Company Profile" GroupName="SettingsTab"
                                 Checked="Tab_Changed" Margin="4,0,0,0"
                                 Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                 Style="{DynamicResource SettingsTabRadioStyle}"/>

                    <RadioButton x:Name="TabBranches" Content="🏬  Branches &amp; Locations" GroupName="SettingsTab"
                                 Checked="Tab_Changed" Margin="4,0,0,0"
                                 Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                 Style="{DynamicResource SettingsTabRadioStyle}"/>

                    <RadioButton x:Name="TabStatutory" Content="🏛️  Statutory Rates" GroupName="SettingsTab"
                                 Checked="Tab_Changed" Margin="4,0,0,0"
                                 Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                 Style="{DynamicResource SettingsTabRadioStyle}"/>

                    <RadioButton x:Name="TabDatabase" Content="🔌  Database Connection" GroupName="SettingsTab"
                                 Checked="Tab_Changed" Margin="4,0,0,0"
                                 Height="36" Padding="16,0" FontWeight="Bold" FontSize="12" Cursor="Hand"
                                 Style="{DynamicResource SettingsTabRadioStyle}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Content Panels -->
        <Grid Grid.Row="1">

            <!-- ═══ 1. USER ACCOUNTS PANEL ═══ -->
            <Grid x:Name="UsersPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Users Toolbar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- User Counter Badge -->
                        <Border Grid.Column="0" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUserCount" Text="0 users" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                        </Border>

                        <!-- Search Box -->
                        <TextBox Grid.Column="1" x:Name="TxtUserSearch" Style="{StaticResource ModernInputStyle}"
                                 Height="38" TextChanged="TxtUserSearch_TextChanged"
                                 ToolTip="Search users by username, full name, or email"/>

                        <!-- Add User Button -->
                        <Button x:Name="BtnAddUser" Grid.Column="3" Content="➕  Add User Account"
                                Style="{StaticResource PrimaryBtnStyle}" Height="38" Padding="16,0"
                                Click="BtnAddUser_Click" ToolTip="Create a new administrative, HR, or accounting user"/>
                    </Grid>
                </Border>

                <!-- Users DataGrid & Empty State Container -->
                <Grid Grid.Row="1" Margin="20,16,20,20">
                    <DataGrid x:Name="UsersGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                              HeadersVisibility="Column" CanUserResizeRows="False"
                              ColumnHeaderHeight="40" RowHeight="50">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F7FF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="USERNAME" Binding="{Binding Username}" Width="130"/>
                            <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="200"/>
                            <!-- Role badge -->
                            <DataGridTemplateColumn Header="ROLE" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E9D8FD"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="HR">
                                                            <Setter Property="Background" Value="#BEE3F8"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Accounting">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#44337A"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                                <Setter Property="Foreground" Value="#9B2C2C"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="HR">
                                                                <Setter Property="Foreground" Value="#1A365D"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="Accounting">
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Status badge -->
                            <DataGridTemplateColumn Header="STATUS" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Active"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive"/>
                                                                <Setter Property="Foreground" Value="#9B2C2C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLoginAt, StringFormat='MMM dd, yyyy hh:mm tt'}" Width="160"/>
                            <!-- Actions -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="190">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,0">
                                            <Button Content="✏️ Edit" Tag="{Binding Id}" Click="BtnEditUser_Click"
                                                    Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                                    Height="28" Padding="8,0" FontSize="11" FontWeight="Bold"
                                                    Cursor="Hand" Margin="0,0,4,0"/>
                                            <Button Content="🔑 Password" Tag="{Binding Id}" Click="BtnResetPassword_Click"
                                                    Background="#FEFCBF" Foreground="#744210" BorderThickness="0"
                                                    Height="28" Padding="8,0" FontSize="11" FontWeight="Bold"
                                                    Cursor="Hand" Margin="0,0,4,0"/>
                                            <Button Content="⛔" Tag="{Binding Id}" Click="BtnToggleUser_Click"
                                                    Background="#FFF5F5" Foreground="#C53030" BorderThickness="0"
                                                    Height="28" Width="28" FontSize="12" Cursor="Hand"
                                                    ToolTip="Deactivate / Reactivate User"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State for Users -->
                    <Border x:Name="BorderNoUsers" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="30" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No user accounts found" FontSize="15" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try clearing your search query or click '+ Add User Account' to create one."
                                       FontSize="12" Foreground="#718096" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                            <Button Content="Clear Search" Style="{StaticResource PrimaryBtnStyle}" Height="34" Padding="14,0" HorizontalAlignment="Center" Click="BtnClearUserSearch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══ 2. COMPANY PROFILE PANEL ═══ -->
            <Grid x:Name="CompanyPanel" Visibility="Collapsed">
                <ScrollViewer Padding="30,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="🏢  Corporate Profile &amp; Statutory Remittance Data" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,4"/>
                        <TextBlock Text="These company details and employer statutory numbers appear on statutory remittance reports and payslips." FontSize="13" Foreground="#718096" Margin="0,0,0,20"/>

                        <!-- 1. Corporate Identity Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="COMPANY IDENTIFICATION" FontSize="12" FontWeight="Bold" Foreground="#0A4D9C" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="REGISTERED CORPORATE NAME *" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtCompName" Style="{StaticResource ModernInputStyle}" ToolTip="Legal registered name of company"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="TRADE NAME / DBA" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtTradeName" Style="{StaticResource ModernInputStyle}" ToolTip="Brand or trade name"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="OFFICIAL EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtCompEmail" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CONTACT NUMBER" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtCompContact" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,12,0,0">
                                    <TextBlock Text="HEADQUARTERS ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                    <TextBox x:Name="TxtCompAddress" Style="{StaticResource ModernInputStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- 2. Employer Government Numbers Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="EMPLOYER STATUTORY REMITTANCE NUMBERS" FontSize="12" FontWeight="Bold" Foreground="#276749" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EMPLOYER SSS NUMBER" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtEmpSss" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. 09-1234567-8"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PHILHEALTH EMPLOYER NUMBER (PEN)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtEmpPh" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. 12-345678901-2"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PAG-IBIG EMPLOYER ID" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtEmpPagIbig" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. 1234-5678-9012"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="CORPORATE TIN" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtEmpTin" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. 000-123-456-000"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Authorized Signatory Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="AUTHORIZED SIGNATORY (FOR GOVERNMENT FORMS &amp; PAYSLIPS)" FontSize="12" FontWeight="Bold" Foreground="#744210" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AUTHORIZED SIGNATORY NAME" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSignatoryName" Style="{StaticResource ModernInputStyle}" ToolTip="Full name of Authorized Representative"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DESIGNATION / OFFICIAL TITLE" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSignatoryTitle" Style="{StaticResource ModernInputStyle}" ToolTip="e.g. HR &amp; Administrative Manager"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Save Company Button -->
                        <Button x:Name="BtnSaveCompany" Content="💾  Save &amp; Apply Company Profile" Style="{StaticResource PrimaryBtnStyle}"
                                Height="42" Padding="24,0" FontSize="13" HorizontalAlignment="Left" Click="BtnSaveCompany_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ 3. BRANCHES & LOCATIONS PANEL ═══ -->
            <Grid x:Name="BranchesPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Branches Toolbar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#EBF8FF" BorderBrush="#BEE3F8" BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <TextBlock x:Name="TxtBranchCount" Text="0 branch(es)" FontSize="12" FontWeight="Bold" Foreground="#2B6CB0"/>
                        </Border>

                        <Button x:Name="BtnAddBranch" Grid.Column="2" Content="➕  Add New Branch"
                                Style="{StaticResource PrimaryBtnStyle}" Height="38" Padding="16,0"
                                Click="BtnAddBranch_Click" ToolTip="Register a new office branch location"/>
                    </Grid>
                </Border>

                <!-- Branches DataGrid -->
                <Grid Grid.Row="1" Margin="20,16,20,20">
                    <DataGrid x:Name="BranchesGrid" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single"
                              Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                              RowBackground="White" AlternatingRowBackground="#F9FAFB"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EDF2F7"
                              HeadersVisibility="Column" CanUserResizeRows="False"
                              ColumnHeaderHeight="40" RowHeight="48">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#718096"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="FontSize" Value="13"/>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="BRANCH NAME" Binding="{Binding Name}" Width="250"/>
                            <DataGridTextColumn Header="LOCATION / CITY" Binding="{Binding Location}" Width="*"/>
                            <!-- Status badge -->
                            <DataGridTemplateColumn Header="STATUS" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="#C6F6D5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#FED7D7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Text" Value="Active"/>
                                                                <Setter Property="Foreground" Value="#276749"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive"/>
                                                                <Setter Property="Foreground" Value="#9B2C2C"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <!-- Actions -->
                            <DataGridTemplateColumn Header="ACTIONS" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="6,0">
                                            <Button Content="✏️ Edit" Tag="{Binding Id}" Click="BtnEditBranch_Click"
                                                    Background="#EBF8FF" Foreground="#2B6CB0" BorderThickness="0"
                                                    Height="28" Padding="10,0" FontSize="11" FontWeight="Bold"
                                                    Cursor="Hand" Margin="0,0,6,0"/>
                                            <Button Content="⛔" Tag="{Binding Id}" Click="BtnToggleBranch_Click"
                                                    Background="#FFF5F5" Foreground="#C53030" BorderThickness="0"
                                                    Height="28" Width="30" FontSize="12" Cursor="Hand"
                                                    ToolTip="Toggle Active / Inactive Status"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty State for Branches -->
                    <Border x:Name="BorderNoBranches" Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="30" Visibility="Collapsed" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🏬" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="No branch locations registered yet" FontSize="15" FontWeight="Bold" Foreground="#2D3748" HorizontalAlignment="Center"/>
                            <TextBlock Text="Add your main office or regional branches to assign employees."
                                       FontSize="12" Foreground="#718096" HorizontalAlignment="Center" Margin="0,4,0,16"/>
                            <Button Content="➕ Add New Branch" Style="{StaticResource PrimaryBtnStyle}" Height="36" Padding="16,0" HorizontalAlignment="Center" Click="BtnAddBranch_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ═══ 4. STATUTORY & CONTRIBUTION RATES PANEL ═══ -->
            <Grid x:Name="StatutoryPanel" Visibility="Collapsed">
                <ScrollViewer Padding="30,24" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="🏛️  National Statutory Contribution Rates &amp; Caps" FontSize="18" FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure rates, percentages, and salary caps according to official SSS, PhilHealth, Pag-IBIG, and BIR memorandums." FontSize="13" Foreground="#718096" Margin="0,0,0,20"/>

                        <!-- 1. SSS Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="SSS (SOCIAL SECURITY SYSTEM) SETTINGS" FontSize="12" FontWeight="Bold" Foreground="#0A4D9C" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="EMPLOYEE SHARE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSssEeRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="EMPLOYER SHARE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSssErRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="TOTAL SSS RATE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSssTotalRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MINIMUM SALARY CREDIT FLOOR (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSssMinCredit" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MAXIMUM SALARY CREDIT CEILING (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtSssMaxCredit" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. PhilHealth Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="PHILHEALTH PREMIUM SETTINGS" FontSize="12" FontWeight="Bold" Foreground="#276749" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TOTAL PREMIUM RATE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPhTotalRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="EMPLOYEE SHARE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPhEeRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="EMPLOYER SHARE (%)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPhErRate" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="MINIMUM SALARY FLOOR (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPhMinCredit" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MAXIMUM SALARY CEILING (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPhMaxCredit" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Pag-IBIG & BIR Card -->
                        <Border Background="White" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1" Padding="20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="PAG-IBIG (HDMF) &amp; BIR TAX EXEMPTION CAPS" FontSize="12" FontWeight="Bold" Foreground="#744210" Margin="0,0,0,14"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="PAG-IBIG EMPLOYEE STANDARD (₱/MO)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPagIbigEe" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PAG-IBIG EMPLOYER STANDARD (₱/MO)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPagIbigEr" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BIR SEMI-MONTHLY TAX-EXEMPT CEILING (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtBirSemiExempt" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="ANNUAL 13TH MO / BONUS EXEMPT CAP (₱)" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtBirBonusCap" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="BtnSaveStatutory" Content="💾  Save &amp; Apply Statutory Rates" Style="{StaticResource PrimaryBtnStyle}"
                                    Height="42" Padding="20,0" FontSize="13" Margin="0,0,12,0" Click="BtnSaveStatutory_Click"/>
                            <Button x:Name="BtnResetStatutory" Content="🔄  Reset to National Defaults" Background="#EDF2F7" Foreground="#4A5568"
                                    BorderThickness="0" Height="42" Padding="20,0" FontWeight="SemiBold" Cursor="Hand" Click="BtnResetStatutory_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══ 5. DATABASE CONNECTION PANEL ═══ -->
            <Grid x:Name="DatabasePanel" Visibility="Collapsed">
                <ScrollViewer Padding="40,30" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">

                        <TextBlock Text="🔌  PostgreSQL Database Connection" FontSize="18"
                                   FontWeight="Bold" Foreground="#1A202C" Margin="0,0,0,6"/>
                        <TextBlock Text="Configure the connection settings for the Genetian Payroll PostgreSQL server on your local network or VPN."
                                   FontSize="13" Foreground="#718096" TextWrapping="Wrap" Margin="0,0,0,28"/>

                        <!-- Connection Fields Card -->
                        <Border Background="White" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1"
                                Padding="24,20" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="SERVER SETTINGS" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5568" Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SERVER HOST / IP ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtHost" Style="{StaticResource ModernInputStyle}"
                                                 ToolTip="e.g. 192.168.1.100 or localhost"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PORT" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtPort" Style="{StaticResource ModernInputStyle}" ToolTip="Default: 5432"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="DATABASE NAME" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                <TextBox x:Name="TxtDatabase" Style="{StaticResource ModernInputStyle}" Margin="0,0,0,14"/>

                                <TextBlock Text="DATABASE USER SETTINGS" FontSize="11" FontWeight="Bold"
                                           Foreground="#4A5568" Margin="0,8,0,16"/>

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="DB USERNAME" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtDbUser" Style="{StaticResource ModernInputStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DB PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#4A5568" Margin="0,0,0,5"/>
                                        <PasswordBox x:Name="TxtDbPassword" Height="44" FontSize="13"
                                                     BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Connection Test Result -->
                        <Border x:Name="BannerConnection" CornerRadius="8" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtConnectionIcon" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtConnectionStatus" FontSize="13" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtConnectionDetail" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🔍  Test Connection" Background="#EBF8FF" Foreground="#2B6CB0"
                                    BorderBrush="#BEE3F8" BorderThickness="1"
                                    Height="42" Padding="20,0" FontWeight="Bold" FontSize="13"
                                    Cursor="Hand" Margin="0,0,12,0" Click="BtnTestConnection_Click"/>
                            <Button Content="💾  Save &amp; Apply" Style="{StaticResource PrimaryBtnStyle}"
                                    Height="42" Padding="20,0" FontSize="13" Click="BtnSaveConnection_Click"/>
                        </StackPanel>

                        <!-- Info box -->
                        <Border Background="#FFFAF0" BorderBrush="#FEEBC8" BorderThickness="1"
                                CornerRadius="8" Padding="16,12" Margin="0,24,0,0">
                            <StackPanel>
                                <TextBlock Text="💡  Note" FontSize="12" FontWeight="Bold" Foreground="#744210" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12" Foreground="#92400E" TextWrapping="Wrap">
                                    Connection settings are saved per workstation. Changes apply immediately after clicking Save &amp; Apply.
                                    The application will attempt to reconnect on the next database operation.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>

    <UserControl.Resources>
        <Style x:Key="SettingsTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#718096"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A4D9C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EBF4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
</UserControl>
