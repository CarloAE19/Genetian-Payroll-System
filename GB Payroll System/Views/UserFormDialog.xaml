<Window x:Class="GB_Payroll_System.Views.UserFormDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Account" Height="580" Width="540"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#0A4D9C" Padding="24,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtDialogTitle" Text="👤 Add User Account" FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtSubtitle" Text="Create a new system user with role permissions" FontSize="11" Foreground="#93C5FD"/>
                </StackPanel>

                <!-- Status Pill for Edit Mode -->
                <Border x:Name="PillStatus" Grid.Column="1" Background="#DCFCE7" BorderBrush="#BBF7D0" BorderThickness="1"
                        CornerRadius="12" Padding="10,4" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatusBadge" Text="Active Account" FontSize="11" FontWeight="Bold" Foreground="#15803D"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" Padding="24,20" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Full Name + Email -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="FULL NAME *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtFullName" Style="{StaticResource ModernInputStyle}" ToolTip="User's complete formal name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource ModernInputStyle}" ToolTip="Corporate or contact email address"/>
                    </StackPanel>
                </Grid>

                <!-- Username + Role -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="USERNAME *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtUsername" Style="{StaticResource ModernInputStyle}" ToolTip="Unique login identifier (alphanumeric, no spaces)"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="SYSTEM ROLE *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                        <ComboBox x:Name="CboRole" Height="42" FontSize="13" SelectionChanged="CboRole_SelectionChanged">
                            <ComboBoxItem Content="Admin"/>
                            <ComboBoxItem Content="HR" IsSelected="True"/>
                            <ComboBoxItem Content="Accounting"/>
                            <ComboBoxItem Content="Management"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Password fields (Add mode only) -->
                <Border x:Name="PasswordPanel" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TxtPassword" Height="42" FontSize="13"
                                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"
                                         ToolTip="Minimum 6 characters"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="CONFIRM PASSWORD *" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,5"/>
                            <PasswordBox x:Name="TxtConfirmPassword" Height="42" FontSize="13"
                                         BorderBrush="#E2E8F0" BorderThickness="1" Padding="12,0"
                                         ToolTip="Re-type password to verify"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Edit Mode Quick Actions (Password Reset & Toggle Status) -->
                <Border x:Name="EditActionsPanel" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="SECURITY &amp; ACCOUNT STATUS" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                            <TextBlock x:Name="TxtAccountMeta" Text="Created: — | Last Login: —" FontSize="11" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="🔑 Reset Password" Background="#FEFCBF" Foreground="#744210"
                                    BorderThickness="0" Height="32" Padding="12,0" FontSize="11" FontWeight="Bold"
                                    Cursor="Hand" Margin="0,0,8,0" Click="BtnQuickResetPassword_Click"/>
                            <Button x:Name="BtnToggleStatus" Content="⛔ Deactivate"
                                    Background="#FFF5F5" Foreground="#C53030" BorderThickness="0"
                                    Height="32" Padding="12,0" FontSize="11" FontWeight="Bold"
                                    Cursor="Hand" Click="BtnToggleStatus_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Role description & Dynamic Permissions Box -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ROLE ACCESS SUMMARY" FontSize="11" FontWeight="Bold" Foreground="#0A4D9C" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtRoleSummary" FontSize="12" Foreground="#475569" TextWrapping="Wrap" LineHeight="18">
                            • Full access to manage Employees, Attendance, Payroll runs, Government reports, and System Settings.
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Error Banner -->
                <Border x:Name="BannerError" Background="#FFF5F5" BorderBrush="#FEB2B2" BorderThickness="1"
                        CornerRadius="6" Padding="12,8" Margin="0,4,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="TxtError" Foreground="#C53030" FontSize="12" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="24,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" Background="#EDF2F7" Foreground="#475569" BorderThickness="0"
                        Height="40" Padding="20,0" FontWeight="SemiBold" Cursor="Hand"
                        Margin="0,0,12,0" IsCancel="True" Click="BtnCancel_Click"/>
                <Button x:Name="BtnSave" Content="💾  Save Account" Style="{StaticResource PrimaryBtnStyle}"
                        Height="40" Padding="20,0" IsDefault="True" Click="BtnSave_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
